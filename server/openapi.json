{
  "components" : {
    "schemas" : {
      "Hike" : {
        "properties" : {
          "date" : {
            "format" : "date",
            "type" : [
              "string",
              "null"
            ]
          },
          "deleted" : {
            "type" : "boolean"
          },
          "finishedAt" : {
            "format" : "date-time",
            "type" : [
              "string",
              "null"
            ]
          },
          "id" : {
            "format" : "uuid",
            "type" : "string"
          },
          "notes" : {
            "type" : "string"
          },
          "notesVisibility" : {
            "enum" : [
              "PRIVATE",
              "FRIENDS",
              "PUBLIC"
            ],
            "type" : "string"
          },
          "plan" : {
            "oneOf" : [
              {
                "$ref" : "#/components/schemas/HikePlan"
              },
              {
                "type" : "null"
              }
            ]
          },
          "revision" : {
            "format" : "int64",
            "type" : "integer"
          },
          "routeId" : {
            "type" : "string"
          },
          "startedAt" : {
            "format" : "date-time",
            "type" : [
              "string",
              "null"
            ]
          },
          "updatedAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "visibility" : {
            "enum" : [
              "PRIVATE",
              "FRIENDS",
              "PUBLIC"
            ],
            "type" : "string"
          }
        },
        "required" : [
          "date",
          "deleted",
          "finishedAt",
          "id",
          "notes",
          "notesVisibility",
          "plan",
          "revision",
          "routeId",
          "startedAt",
          "updatedAt",
          "visibility"
        ],
        "type" : "object"
      },
      "HikeChanges" : {
        "properties" : {
          "hasMore" : {
            "type" : "boolean"
          },
          "hikes" : {
            "items" : {
              "$ref" : "#/components/schemas/Hike"
            },
            "type" : "array"
          },
          "next" : {
            "format" : "int64",
            "type" : "integer"
          }
        },
        "required" : [
          "hasMore",
          "hikes",
          "next"
        ],
        "type" : "object"
      },
      "HikePlan" : {
        "properties" : {
          "approach" : {
            "type" : "string"
          },
          "exit" : {
            "type" : "string"
          },
          "main" : {
            "type" : "string"
          },
          "reversed" : {
            "type" : "boolean"
          }
        },
        "required" : [
          "reversed"
        ],
        "type" : "object"
      },
      "HikeWrite" : {
        "properties" : {
          "date" : {
            "format" : "date",
            "type" : [
              "string",
              "null"
            ]
          },
          "deleted" : {
            "type" : "boolean"
          },
          "finishedAt" : {
            "format" : "date-time",
            "type" : [
              "string",
              "null"
            ]
          },
          "notes" : {
            "type" : "string"
          },
          "notesVisibility" : {
            "enum" : [
              "PRIVATE",
              "FRIENDS",
              "PUBLIC"
            ],
            "type" : "string"
          },
          "plan" : {
            "oneOf" : [
              {
                "$ref" : "#/components/schemas/HikePlan"
              },
              {
                "type" : "null"
              }
            ]
          },
          "routeId" : {
            "type" : "string"
          },
          "startedAt" : {
            "format" : "date-time",
            "type" : [
              "string",
              "null"
            ]
          },
          "updatedAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "visibility" : {
            "enum" : [
              "PRIVATE",
              "FRIENDS",
              "PUBLIC"
            ],
            "type" : "string"
          }
        },
        "required" : [
          "deleted",
          "notes",
          "notesVisibility",
          "routeId",
          "updatedAt",
          "visibility"
        ],
        "type" : "object"
      },
      "Login" : {
        "properties" : {
          "email" : {
            "minLength" : 1,
            "type" : "string"
          },
          "password" : {
            "maxLength" : 72,
            "minLength" : 0,
            "type" : "string"
          }
        },
        "required" : [
          "email",
          "password"
        ],
        "type" : "object"
      },
      "MeResponse" : {
        "properties" : {
          "displayName" : {
            "type" : "string"
          },
          "email" : {
            "type" : "string"
          },
          "id" : {
            "format" : "uuid",
            "type" : "string"
          },
          "initials" : {
            "type" : "string"
          },
          "role" : {
            "enum" : [
              "USER",
              "ADMIN"
            ],
            "type" : "string"
          }
        },
        "required" : [
          "displayName",
          "id",
          "initials",
          "role"
        ],
        "type" : "object"
      },
      "Oidc" : {
        "properties" : {
          "displayName" : {
            "type" : "string"
          },
          "idToken" : {
            "minLength" : 1,
            "type" : "string"
          },
          "provider" : {
            "enum" : [
              "GOOGLE",
              "APPLE"
            ],
            "type" : "string"
          }
        },
        "required" : [
          "idToken",
          "provider"
        ],
        "type" : "object"
      },
      "RefreshToken" : {
        "properties" : {
          "refreshToken" : {
            "minLength" : 1,
            "type" : "string"
          }
        },
        "required" : [
          "refreshToken"
        ],
        "type" : "object"
      },
      "Register" : {
        "properties" : {
          "displayName" : {
            "type" : "string"
          },
          "email" : {
            "minLength" : 1,
            "type" : "string"
          },
          "password" : {
            "maxLength" : 72,
            "minLength" : 10,
            "type" : "string"
          }
        },
        "required" : [
          "displayName",
          "email",
          "password"
        ],
        "type" : "object"
      },
      "TokenPair" : {
        "properties" : {
          "accessExpiresAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "accessToken" : {
            "type" : "string"
          },
          "refreshToken" : {
            "type" : "string"
          }
        },
        "required" : [
          "accessExpiresAt",
          "accessToken",
          "refreshToken"
        ],
        "type" : "object"
      },
      "UpdateMeRequest" : {
        "properties" : {
          "displayName" : {
            "type" : "string"
          }
        },
        "required" : [
          "displayName"
        ],
        "type" : "object"
      }
    }
  },
  "openapi" : "3.1.0",
  "paths" : {
    "/api/v1/auth/login" : {
      "post" : {
        "operationId" : "login",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/Login"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/TokenPair"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [
          "auth-controller"
        ]
      }
    },
    "/api/v1/auth/logout" : {
      "post" : {
        "operationId" : "logout",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/RefreshToken"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "204" : {
            "description" : "No Content"
          }
        },
        "tags" : [
          "auth-controller"
        ]
      }
    },
    "/api/v1/auth/oidc" : {
      "post" : {
        "operationId" : "oidc",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/Oidc"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/TokenPair"
                }
              }
            },
            "description" : "Signed in an existing user"
          },
          "201" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/TokenPair"
                }
              }
            },
            "description" : "Created a new user and signed them in"
          }
        },
        "tags" : [
          "auth-controller"
        ]
      }
    },
    "/api/v1/auth/refresh" : {
      "post" : {
        "operationId" : "refresh",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/RefreshToken"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/TokenPair"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [
          "auth-controller"
        ]
      }
    },
    "/api/v1/auth/register" : {
      "post" : {
        "operationId" : "register",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/Register"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/TokenPair"
                }
              }
            },
            "description" : "Created"
          }
        },
        "tags" : [
          "auth-controller"
        ]
      }
    },
    "/api/v1/hikes" : {
      "get" : {
        "operationId" : "changes",
        "parameters" : [
          {
            "in" : "query",
            "name" : "since",
            "required" : false,
            "schema" : {
              "default" : 0,
              "format" : "int64",
              "type" : "integer"
            }
          },
          {
            "in" : "query",
            "name" : "limit",
            "required" : false,
            "schema" : {
              "default" : 500,
              "format" : "int32",
              "type" : "integer"
            }
          }
        ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/HikeChanges"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [
          "hike-controller"
        ]
      }
    },
    "/api/v1/hikes/{id}" : {
      "put" : {
        "operationId" : "put",
        "parameters" : [
          {
            "in" : "path",
            "name" : "id",
            "required" : true,
            "schema" : {
              "format" : "uuid",
              "type" : "string"
            }
          }
        ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/HikeWrite"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Hike"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [
          "hike-controller"
        ]
      }
    },
    "/api/v1/me" : {
      "get" : {
        "operationId" : "get",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MeResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [
          "me-controller"
        ]
      },
      "patch" : {
        "operationId" : "update",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/UpdateMeRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MeResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [
          "me-controller"
        ]
      }
    }
  },
  "servers" : [
    {
      "url" : "/"
    }
  ]
}
