{
  "components" : {
    "schemas" : {
      "Login" : {
        "properties" : {
          "email" : {
            "minLength" : 1,
            "type" : "string"
          },
          "password" : {
            "maxLength" : 72,
            "minLength" : 0,
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "MeResponse" : {
        "properties" : {
          "displayName" : {
            "type" : "string"
          },
          "email" : {
            "type" : "string"
          },
          "id" : {
            "format" : "uuid",
            "type" : "string"
          },
          "initials" : {
            "type" : "string"
          },
          "role" : {
            "enum" : [
              "USER",
              "ADMIN"
            ],
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "Oidc" : {
        "properties" : {
          "displayName" : {
            "type" : "string"
          },
          "idToken" : {
            "minLength" : 1,
            "type" : "string"
          },
          "provider" : {
            "enum" : [
              "GOOGLE",
              "APPLE"
            ],
            "type" : "string"
          }
        },
        "required" : [
          "provider"
        ],
        "type" : "object"
      },
      "RefreshToken" : {
        "properties" : {
          "refreshToken" : {
            "minLength" : 1,
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "Register" : {
        "properties" : {
          "displayName" : {
            "type" : "string"
          },
          "email" : {
            "minLength" : 1,
            "type" : "string"
          },
          "password" : {
            "maxLength" : 72,
            "minLength" : 10,
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "TokenPair" : {
        "properties" : {
          "accessExpiresAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "accessToken" : {
            "type" : "string"
          },
          "refreshToken" : {
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "UpdateMeRequest" : {
        "properties" : {
          "displayName" : {
            "type" : "string"
          }
        },
        "type" : "object"
      }
    }
  },
  "openapi" : "3.1.0",
  "paths" : {
    "/api/v1/auth/login" : {
      "post" : {
        "operationId" : "login",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/Login"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/TokenPair"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [
          "auth-controller"
        ]
      }
    },
    "/api/v1/auth/logout" : {
      "post" : {
        "operationId" : "logout",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/RefreshToken"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "204" : {
            "description" : "No Content"
          }
        },
        "tags" : [
          "auth-controller"
        ]
      }
    },
    "/api/v1/auth/oidc" : {
      "post" : {
        "operationId" : "oidc",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/Oidc"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/TokenPair"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [
          "auth-controller"
        ]
      }
    },
    "/api/v1/auth/refresh" : {
      "post" : {
        "operationId" : "refresh",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/RefreshToken"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/TokenPair"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [
          "auth-controller"
        ]
      }
    },
    "/api/v1/auth/register" : {
      "post" : {
        "operationId" : "register",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/Register"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/TokenPair"
                }
              }
            },
            "description" : "Created"
          }
        },
        "tags" : [
          "auth-controller"
        ]
      }
    },
    "/api/v1/me" : {
      "get" : {
        "operationId" : "get",
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MeResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [
          "me-controller"
        ]
      },
      "patch" : {
        "operationId" : "update",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/UpdateMeRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MeResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [
          "me-controller"
        ]
      }
    }
  },
  "servers" : [
    {
      "url" : "/"
    }
  ]
}
