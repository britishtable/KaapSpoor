# These scripts run in WSL/Linux, where a CR on the shebang or a line
# continuation is a syntax error. core.autocrlf=true would otherwise rewrite
# them to CRLF on every checkout, so pin the ones that must stay LF.
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Generated files. Keep LF so regenerating them on Windows shows no diff (CI runs git diff --exit-code).
server/openapi.json text eol=lf
app/src/lib/api/schema.d.ts text eol=lf
